# Copy outside the repository as terraform.tfvars. Never store secret values here.
project_id            = "your-gcp-project-id"
region                = "asia-south1"
environment           = "production"
firestore_database_id = "driftguard-db"
firestore_location_id = "asia-south1"

# Keep false until its dedicated reviewed plan is approved.
enable_firestore_deletion_protection = false

# Both are false by default: this example must remain safe to plan locally.
enable_hosted_beta_foundation = false
enable_runtime_services       = false
public_transport_enabled      = false

# Required only for Stage 2. Image references should use immutable digests, not
# mutable tags. Terraform derives the service, frontend, CORS, and OAuth callback
# URLs from the project number, region, and fixed service names.
api_image                  = ""
web_image                  = ""
github_app_install_url     = ""
beta_allowed_github_logins = ""

# The controlled beta deliberately allows only one of each service.
api_max_instances = 1
web_max_instances = 1
