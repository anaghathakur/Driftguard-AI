# DriftGuard API configuration. Copy to .env and start uvicorn with --env-file .env.
# This file intentionally contains no credentials and defaults to a zero-cost local workflow.

# Core / CORS
# Comma-separated browser origins only; wildcards and URL paths are rejected.
DRIFTGUARD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Authentication and browser session security
# local preserves anonymous/demo workflows. github requires OAuth and a strong secret.
DRIFTGUARD_ENVIRONMENT=development
DRIFTGUARD_AUTH_MODE=local
DRIFTGUARD_SESSION_SECRET=
DRIFTGUARD_SESSION_COOKIE_NAME=driftguard_session
DRIFTGUARD_SESSION_TTL_HOURS=168
DRIFTGUARD_SECURE_COOKIES=false
DRIFTGUARD_SESSION_COOKIE_SAME_SITE=lax
DRIFTGUARD_FRONTEND_URL=http://localhost:5173
DRIFTGUARD_GITHUB_OAUTH_PROVIDER=github
DRIFTGUARD_GITHUB_OAUTH_CLIENT_ID=
DRIFTGUARD_GITHUB_OAUTH_CLIENT_SECRET=
DRIFTGUARD_GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
DRIFTGUARD_GITHUB_APP_INSTALL_URL=
# Required in production. Comma-separated approved GitHub login names; leave blank locally.
DRIFTGUARD_BETA_ALLOWED_GITHUB_LOGINS=

# Storage
DRIFTGUARD_STORAGE_BACKEND=sqlite
DRIFTGUARD_DATABASE_PATH=data/driftguard.sqlite3
DRIFTGUARD_FIRESTORE_PROJECT_ID=
DRIFTGUARD_FIRESTORE_DATABASE_ID=(default)

# Local ML risk model
DRIFTGUARD_RISK_MODEL_PATH=apps/api/models/risk/v1.0.0/risk_model.joblib
DRIFTGUARD_RISK_MODEL_METADATA_PATH=apps/api/models/risk/v1.0.0/metadata.json

# Migration and patch providers
# mock is deterministic, development-only, offline, and zero-cost. Production rejects it.
DRIFTGUARD_MIGRATION_PROVIDER=deterministic
DRIFTGUARD_PATCH_PROVIDER=deterministic
DRIFTGUARD_TEST_PLAN_PROVIDER=deterministic
# disabled is production-safe. local is an opt-in development/test process runner only.
DRIFTGUARD_VALIDATION_EXECUTION_PROVIDER=disabled
DRIFTGUARD_GEMINI_API_KEY=
DRIFTGUARD_GEMINI_MODEL=gemini-3.6-flash
DRIFTGUARD_AI_TIMEOUT_SECONDS=20
DRIFTGUARD_AI_MAX_RETRIES=1
DRIFTGUARD_AI_PROMPT_VERSION=migration-prompt-v1
DRIFTGUARD_AI_SCHEMA_VERSION=migration-schema-v1

# Remote OpenAPI acquisition. Production must keep this false until DNS-pinned outbound
# fetching is available. Upload and GitHub App contract-file sources remain available.
DRIFTGUARD_REMOTE_SPECIFICATION_URLS_ENABLED=true
DRIFTGUARD_RATE_LIMIT_ENABLED=false
DRIFTGUARD_REMOTE_SPEC_TIMEOUT_SECONDS=20
DRIFTGUARD_REMOTE_SPEC_MAX_REDIRECTS=3
DRIFTGUARD_MAX_SPEC_FILE_BYTES=5242880

# Repository acquisition and archive scanning
DRIFTGUARD_GITHUB_TIMEOUT_SECONDS=20
DRIFTGUARD_MAX_REPOSITORY_ARCHIVE_BYTES=20971520
DRIFTGUARD_MAX_REPOSITORY_FILES=10000
DRIFTGUARD_MAX_GRAPHQL_DOCUMENT_BYTES=5242880
DRIFTGUARD_MAX_GRAPHQL_AST_NODES=100000
DRIFTGUARD_MAX_GRAPHQL_CHANGES=1000
DRIFTGUARD_MAX_GRAPHQL_QUERY_DOCUMENTS=500
DRIFTGUARD_MAX_REPOSITORY_FILE_BYTES=2097152
DRIFTGUARD_MAX_REPOSITORY_UNCOMPRESSED_BYTES=52428800
DRIFTGUARD_MAX_REPOSITORY_COMPRESSION_RATIO=100
DRIFTGUARD_MAX_REPOSITORY_TREE_ENTRIES=20000
DRIFTGUARD_MAX_REPOSITORY_SOURCE_FILES=7500
DRIFTGUARD_MAX_REPOSITORY_SOURCE_FILE_BYTES=2097152
DRIFTGUARD_MAX_REPOSITORY_SOURCE_BYTES=26214400

# Contract subscriptions use this process-local scheduler. It is disabled for
# deterministic local startup; run exactly one API/scheduler process when enabled.
# HTTP sources are HTTPS-only and SSRF-protected. GitHub-file sources require the
# configured GitHub App; no personal access token is accepted.
DRIFTGUARD_MONITOR_SCHEDULER_ENABLED=false
DRIFTGUARD_MONITOR_POLL_SECONDS=30
DRIFTGUARD_MONITOR_CHECK_LEASE_SECONDS=900

# Static analysis
DRIFTGUARD_MAX_CODE_SYMBOLS=10000
DRIFTGUARD_MAX_CODE_GRAPH_EDGES=25000
DRIFTGUARD_MAX_IMPACT_DEPTH=3

# Proposed patch limits
DRIFTGUARD_MAX_PATCH_FILES=5
DRIFTGUARD_MAX_PATCH_EDITS=20
DRIFTGUARD_MAX_PATCH_CONTEXT_BYTES=40000
DRIFTGUARD_MAX_PATCH_REPLACEMENT_BYTES=20000
DRIFTGUARD_MAX_PATCH_DIFF_BYTES=100000

# Static validation and test intelligence
# deterministic is rules-based and auditable; Gemini is optional for richer suggestions.
DRIFTGUARD_MAX_VALIDATION_FINDINGS=100
DRIFTGUARD_MAX_RELATED_TESTS=50
DRIFTGUARD_MAX_TEST_PLAN_CASES=12
DRIFTGUARD_MAX_TEST_CONTEXT_BYTES=40000

# GitHub Pull Request writes
# mock performs no network write and is rejected in production. github_app uses server-only credentials.
DRIFTGUARD_GITHUB_WRITE_PROVIDER=mock
DRIFTGUARD_GITHUB_APP_ID=
DRIFTGUARD_GITHUB_APP_PRIVATE_KEY_PATH=
DRIFTGUARD_MAX_PULL_REQUEST_BODY_BYTES=20000
DRIFTGUARD_MAX_PULL_REQUEST_MODIFIED_BYTES=1048576

# GitHub-native automation. The webhook secret and App key are server-only.
# mock records deterministic Check Runs only in development/test and is rejected in production.
DRIFTGUARD_GITHUB_WEBHOOK_SECRET=
DRIFTGUARD_MAX_WEBHOOK_BYTES=2097152
DRIFTGUARD_GITHUB_CHECK_PROVIDER=mock
DRIFTGUARD_AUTOMATION_WORKER_ENABLED=false
DRIFTGUARD_AUTOMATION_WORKER_POLL_SECONDS=5
DRIFTGUARD_AUTOMATION_MAX_RETRIES=3
DRIFTGUARD_AUTOMATION_RETRY_BASE_SECONDS=15
DRIFTGUARD_MAX_CHECK_ANNOTATIONS=50
